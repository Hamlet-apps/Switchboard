# Set this to "production" on a real server: DEBUG goes off and SECRET_KEY becomes required.
ENVIRONMENT=development
# Long random text. It also encrypts the keys Switchboard keeps, so changing it means
# reconnecting every building and re-entering every secret.
SECRET_KEY=
# Postgres connection string. Without it Switchboard uses db.sqlite3 next to manage.py.
DATABASE_URL=
# Comma-separated host names this server answers to, e.g. switchboard.example.org
ALLOWED_HOSTS=
# "off" when runs are executed by a separate `python manage.py runworker` process.
SWITCHBOARD_WORKER=on
